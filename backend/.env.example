# Neighbourhood Pulse backend — environment configuration
#
# Copy this file to backend/.env and fill in real values.
# .env is git-ignored.

# ─── Agentic layer (Claude API) ────────────────────────────────────────
# When set, backend/agent.js uses Claude to classify needs, detect distress,
# extract key phrases, and compose warm replies. Falls back to the regex
# classifier in backend/classifier.js if this is empty.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ─── Server ────────────────────────────────────────────────────────────
# Port the Express server listens on (default 3000).
# PORT=3000

# ─── Database ──────────────────────────────────────────────────────────
# Override the SQLite file path (default: backend/data.sqlite).
# NP_DB_PATH=
